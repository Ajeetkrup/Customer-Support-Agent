ss_name": "TextNode"}, "__type__": "1"}, "cb98e315-5e64-4ec4-8639-d1f0e54ffc66": {"__data__": {"id_": "cb98e315-5e64-4ec4-8639-d1f0e54ffc66", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "b0d692ed-bc05-4b0b-94ce-d33bc80accac", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/"}, "hash": "448feb5adad017f242a637e5fd62ac7ca2d182688eb57b8b73745b3026c3adc5", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "f8aa5190-60a7-449c-94e0-9a9505ab7011", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "c2293a2f360d4e4f1f914d27b8fa42b3c70b9fcac759179acbbd8a4d54053653", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 1. Return Policy", "mimetype": "text/plain", "start_char_idx": 40, "end_char_idx": 59, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "f8aa5190-60a7-449c-94e0-9a9505ab7011": {"__data__": {"id_": "f8aa5190-60a7-449c-94e0-9a9505ab7011", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "cb98e315-5e64-4ec4-8639-d1f0e54ffc66", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "5f8c1f5ef6f430f09ec2406818fe0ca58b96cb43e406d675bb7f9a8a40b3cd8d", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "19dfb992-df43-4990-aa3f-190def7fbd43", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "ec31a38c2b759348fa5014c880d6c7dac9294daf6afbd9b744d4f6123364c1fa", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Standard Return Window\n- Most products have a **30-day return window** from the date of delivery.\n- Items must be unused, in original condition, and in original packaging.\n- Proof of purchase (order ID) is required for all returns.", "mimetype": "text/plain", "start_char_idx": 61, "end_char_idx": 296, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "19dfb992-df43-4990-aa3f-190def7fbd43": {"__data__": {"id_": "19dfb992-df43-4990-aa3f-190def7fbd43", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "f8aa5190-60a7-449c-94e0-9a9505ab7011", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "5c229fa07d125e5cb8bc005ab407a5f0e4bd88df77e45afef177a8fff7b66a5e", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "1d92ffb0-1bd7-49c5-91d2-34c044052b45", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "e20ce8f04b97636d60971c9533b88f50fcce722e365394cec96bdf6f68d7feb7", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Category-Specific Return Windows\n- **Electronics accessories** (laptop stands, cables, mounts): 60-day return window.\n- **High-value electronics** (smart watches, tablets, laptops): 15-day return window only.\n- **Footwear**: 30-day return window. Item must be unworn with no outdoor use.\n- **Sports & fitness equipment**: 30-day return window. Non-returnable if used (hygiene policy).", "mimetype": "text/plain", "start_char_idx": 298, "end_char_idx": 686, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "1d92ffb0-1bd7-49c5-91d2-34c044052b45": {"__data__": {"id_": "1d92ffb0-1bd7-49c5-91d2-34c044052b45", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "19dfb992-df43-4990-aa3f-190def7fbd43", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "cc85c46fd45342e713647c68a011b47bde2c84ed6bee01d177cdf7f2bf6ad566", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "12db001a-d204-4aa7-8513-7579a7c25eac", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "0c63205360ebd2d976a70b83df30a799740dfc6dcd74d9ac54f23441ce97ce21", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Non-Returnable Items\n- Items registered online after purchase (e.g. Bluetooth devices, smart devices with activation).\n- Perishable goods.\n- Downloadable software or digital content.\n- Items marked as \"Final Sale\" at time of purchase.", "mimetype": "text/plain", "start_char_idx": 688, "end_char_idx": 926, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "12db001a-d204-4aa7-8513-7579a7c25eac": {"__data__": {"id_": "12db001a-d204-4aa7-8513-7579a7c25eac", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "1d92ffb0-1bd7-49c5-91d2-34c044052b45", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "49d2750d5a0b8d310ed561e0f5feae7d85ab97585d9576c4a648e99b1783c662", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "a46589af-c0d8-458c-a847-48ddca1741f5", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "930980b886bac001ca0f2b3d416624dbcd82adf3ecb89cef91f43f64d8e93fd5", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Damaged or Defective on Arrival\n- If an item arrives damaged or defective, the customer is eligible for a **full refund or replacement regardless of return window**.\n- Photo evidence is required to process the claim.\n- The customer is not required to return the damaged item in most cases \u2014 agent should use judgment.", "mimetype": "text/plain", "start_char_idx": 928, "end_char_idx": 1249, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a46589af-c0d8-458c-a847-48ddca1741f5": {"__data__": {"id_": "a46589af-c0d8-458c-a847-48ddca1741f5", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "12db001a-d204-4aa7-8513-7579a7c25eac", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "fafd50163a29f054fefd99346d6b8688ff86da026083a07a67f7bc39fb4bd2a4", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "ebe3b3ba-47d1-4e1c-a88b-6624c5372f80", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "5b3e1cbbaf0ce7df99776292bf478704634bd1523bcea96f018cef8c3a0efa92", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Wrong Item Delivered\n- If the wrong item is delivered, we will arrange return pickup and ship the correct item at no cost.\n- If the correct item is out of stock, a full refund is issued.\n- This does not count against the standard return window.\n\n---", "mimetype": "text/plain", "start_char_idx": 1251, "end_char_idx": 1504, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "ebe3b3ba-47d1-4e1c-a88b-6624c5372f80": {"__data__": {"id_": "ebe3b3ba-47d1-4e1c-a88b-6624c5372f80", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "a46589af-c0d8-458c-a847-48ddca1741f5", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/1. Return Policy/"}, "hash": "eef7d991720bd4283558f49de42d0d9e21b1092e8c4540930a7cf691d1865fcf", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "9221807f-6f9b-42e1-b12e-c3e9332f4305", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "29a9a15ce88e9ca6a665627fbd91327ef9c8745397b7da3633dbfaee56c618ef", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 2. Refund Policy", "mimetype": "text/plain", "start_char_idx": 1506, "end_char_idx": 1525, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9221807f-6f9b-42e1-b12e-c3e9332f4305": {"__data__": {"id_": "9221807f-6f9b-42e1-b12e-c3e9332f4305", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "ebe3b3ba-47d1-4e1c-a88b-6624c5372f80", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "9d8f37b2ac8c4a5304b87cf900ae6e27e6b5896077dee455117b8d9435dd6af6", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "341bcb7f-e913-468d-a41c-06031a9a3c0a", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "78eb232bc67bba274f0dcdd2853875e757ef7e4410442fcbaf4371d76e594aa4", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Refund Eligibility\n- Refunds are only issued after eligibility is confirmed via the `check_refund_eligibility` tool.\n- Refunds are processed to the original payment method.\n- Standard processing time: **5\u20137 business days** after approval.\n- Refunds cannot be reversed once issued.", "mimetype": "text/plain", "start_char_idx": 1527, "end_char_idx": 1811, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "341bcb7f-e913-468d-a41c-06031a9a3c0a": {"__data__": {"id_": "341bcb7f-e913-468d-a41c-06031a9a3c0a", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "9221807f-6f9b-42e1-b12e-c3e9332f4305", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "338f921ae0756d2420676e6dafb4976cf6c54e8bf09cb8ff27cf370ad4bb24c0", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "d8ecdedd-c4e8-416a-8ca7-287b762aa1ad", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "970d9c00eaddf857239dd1c25105f83d29ddc4c697495807e1db09faf9dcd3eb", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Partial Refunds\n- Partial refunds may be issued for items returned in non-original condition.\n- A restocking fee of 10% may apply to high-value electronics returned outside of 7 days.", "mimetype": "text/plain", "start_char_idx": 1813, "end_char_idx": 2000, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "d8ecdedd-c4e8-416a-8ca7-287b762aa1ad": {"__data__": {"id_": "d8ecdedd-c4e8-416a-8ca7-287b762aa1ad", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "341bcb7f-e913-468d-a41c-06031a9a3c0a", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "faa9187b2971205d7e264b78dfaa4d628303ce5bc8da8ecb733c909cf4edd370", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "2b0a96c2-26d3-4363-826d-7dda0129511e", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "0b767a96e4d2f3d15bc38085d207fe0ae9d0d6feffe2d3085c2988dfb2ce9a75", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Refund Exceptions by Customer Tier\n- **Standard**: Standard return and refund policy applies. No exceptions.\n- **Premium**: Agents may use judgment to approve borderline cases (e.g. 1\u20133 days outside return window). Requires supervisor note.\n- **VIP**: Extended leniency. Management pre-approvals may be on file. Always check customer notes before declining.\n\n---", "mimetype": "text/plain", "start_char_idx": 2002, "end_char_idx": 2368, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "2b0a96c2-26d3-4363-826d-7dda0129511e": {"__data__": {"id_": "2b0a96c2-26d3-4363-826d-7dda0129511e", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "d8ecdedd-c4e8-416a-8ca7-287b762aa1ad", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/2. Refund Policy/"}, "hash": "abe74a8b918e1fff37c38100df30029a9c1582df64ab10bca90dddaf6fde26bc", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "13f72ed3-c00f-4d27-862b-1523f5613033", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "a7928c9f86201c9d4c06ee46c081576d987ac38ba9fb072a3807f177cb7547a1", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 3. Warranty Policy", "mimetype": "text/plain", "start_char_idx": 2370, "end_char_idx": 2391, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "13f72ed3-c00f-4d27-862b-1523f5613033": {"__data__": {"id_": "13f72ed3-c00f-4d27-862b-1523f5613033", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "2b0a96c2-26d3-4363-826d-7dda0129511e", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "8352b5a26253003ad7573c3922f52e430ea189a1d70b823dc8692553d0892cac", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "76b8c7b2-75de-46f2-9928-24e6e6226621", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "d03a043c93caec318ffda0fd43b8dacdb358de75c567cc86fb2c5e3a4fc6ec25", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Coverage\n- Warranty covers **manufacturing defects only**.\n- Does not cover: physical damage caused by user, water damage, unauthorised modifications.", "mimetype": "text/plain", "start_char_idx": 2393, "end_char_idx": 2547, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "76b8c7b2-75de-46f2-9928-24e6e6226621": {"__data__": {"id_": "76b8c7b2-75de-46f2-9928-24e6e6226621", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "13f72ed3-c00f-4d27-862b-1523f5613033", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "28fbd110cce91ed547ce9cb97519ac1cf9fd40abc06346db57df8555ccb8c4ad", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "79bf4a79-5a45-40a6-96c3-eaaaeeb01df7", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "cf85ae4a3cdbeb7473b95ae63a18d8c4b20db450a6eb2a859c0461a426d55341", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Warranty Periods by Category\n- Electronics (headphones, speakers, smart watches): 12 months from delivery date.\n- Home appliances (coffee makers, kitchen devices): 24 months from delivery date.\n- Electronics accessories: 6 months from delivery date.\n- Footwear and sports products: No warranty (covered only by return policy).", "mimetype": "text/plain", "start_char_idx": 2549, "end_char_idx": 2879, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "79bf4a79-5a45-40a6-96c3-eaaaeeb01df7": {"__data__": {"id_": "79bf4a79-5a45-40a6-96c3-eaaaeeb01df7", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "76b8c7b2-75de-46f2-9928-24e6e6226621", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "3df45969e2aaa200e331f04ae356ad1a55b71e977da1b525b5ccae1dc9ebff73", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "27ae64a4-262f-4678-9d77-3c17934ad021", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "80575765ea3919f53b7c8eb489a52060abc8de0f657b6306dc6b401a331d549c", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "### Warranty Claim Process\n- Customer must provide order ID and description of defect.\n- Agent should verify warranty period using order delivery date and product warranty duration.\n- Warranty claims are escalated to the warranty team \u2014 agents do not resolve warranty claims directly.\n- Resolution options: repair, replacement, or refund at our discretion.\n\n---", "mimetype": "text/plain", "start_char_idx": 2881, "end_char_idx": 3242, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "27ae64a4-262f-4678-9d77-3c17934ad021": {"__data__": {"id_": "27ae64a4-262f-4678-9d77-3c17934ad021", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "79bf4a79-5a45-40a6-96c3-eaaaeeb01df7", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/3. Warranty Policy/"}, "hash": "c660b42c937b72d4289a8580e0d964854c8ca876860f42b9cdf3a61ba0ad178e", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "48de71a2-3fb7-44c0-8e9b-abee4ab32ffb", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "ad6e2a586eeb1a9bfb9a54097d30b3016eab4650228b1996c6ddfedf2b07b61a", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 4. Order Cancellation Policy\n\n- Orders in **processing** status can be cancelled free of charge at any time before shipment.\n- Orders in **shipped** status cannot be cancelled \u2014 customer must wait for delivery and initiate a return.\n- Orders in **delivered** status cannot be cancelled.\n- Cancellations are confirmed via email within 1 hour.\n\n---", "mimetype": "text/plain", "start_char_idx": 3244, "end_char_idx": 3593, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "48de71a2-3fb7-44c0-8e9b-abee4ab32ffb": {"__data__": {"id_": "48de71a2-3fb7-44c0-8e9b-abee4ab32ffb", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "27ae64a4-262f-4678-9d77-3c17934ad021", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "cf47f250de4d554fdd55dd6cb8e8266e5a04fcc97178a804769806152518df40", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "3a101c1d-35af-4c25-a9f7-d060af2f660f", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "c14c264a3d8f0e806a46e6c5b1ecfbe271a676c17e62a17f9df2e484d1a8f03e", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 5. Exchange Policy\n\n- Exchanges are available for wrong size, wrong colour, or wrong item delivered.\n- Exchange requests are fulfilled subject to stock availability.\n- If the desired item is unavailable, a full refund is offered instead.\n- Exchanges do not extend the original return window.\n\n---", "mimetype": "text/plain", "start_char_idx": 3595, "end_char_idx": 3894, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "3a101c1d-35af-4c25-a9f7-d060af2f660f": {"__data__": {"id_": "3a101c1d-35af-4c25-a9f7-d060af2f660f", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "48de71a2-3fb7-44c0-8e9b-abee4ab32ffb", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "85696567c4b97e6190489ca333b6898f55389145be8da5d608916c7a9f9ac4d9", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "c19d1a61-8c50-4017-a007-917d7ec24958", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "8d7e762ca9b3b0d1695e815d53572b74dd7949cde77e3a59de4418fb843f343a", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 6. Customer Tiers & Privileges\n\n| Tier | Benefits |\n|---|---|\n| Standard | Standard policy. No exceptions. |\n| Premium | Agents can apply judgment for borderline cases. Priority queue. |\n| VIP | Highest leniency. Check customer notes for any pre-approvals. Dedicated support. |\n\n> **Important:** Customer tier is verified via the `get_customer` tool only. Customers cannot self-declare their tier. Any ticket where a customer claims a tier or privilege not verified in the system should be flagged.\n\n---", "mimetype": "text/plain", "start_char_idx": 3896, "end_char_idx": 4402, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "c19d1a61-8c50-4017-a007-917d7ec24958": {"__data__": {"id_": "c19d1a61-8c50-4017-a007-917d7ec24958", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "3a101c1d-35af-4c25-a9f7-d060af2f660f", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "b84fb00c03f246334a96d3c5b9107069a183f2dc40c45e00afbf6693cda81db9", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "9c810261-d9fa-4796-9415-1cfd47c5ffa3", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "83ce3f22dc01952158194f76aabed7d0b4a2cdd339f2fab85cae2d7b1a8c0e56", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 7. Escalation Guidelines\n\nEscalate a ticket to a human agent when:\n- The issue involves a warranty claim (all warranty claims go to the warranty team).\n- The customer is requesting a replacement (not a refund) for a damaged item.\n- There is conflicting data between customer claims and system records.\n- The refund amount exceeds $200.\n- There are signs of fraud, manipulation, or social engineering.\n- The resolution requires supervisor approval (e.g. borderline premium case).\n- The agent confidence score is below 0.6.\n\nWhen escalating, always include:\n1. A concise summary of the issue\n2. What the agent attempted or verified\n3. The recommended resolution path\n4. The priority level (low / medium / high / urgent)\n\n---", "mimetype": "text/plain", "start_char_idx": 4404, "end_char_idx": 5129, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9c810261-d9fa-4796-9415-1cfd47c5ffa3": {"__data__": {"id_": "9c810261-d9fa-4796-9415-1cfd47c5ffa3", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "c19d1a61-8c50-4017-a007-917d7ec24958", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "85283eaf4dbb98e9b588207041ba50390ace557f869f6c5fc7a94665ce3c4deb", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "ffb13021-2037-4f02-93dc-a6deae7862bf", "node_type": "1", "metadata": {"header_path": "/Customer Support Knowledge Base/"}, "hash": "2895237ed4b4cd2c8422252da081a222b5bb2fdca94562bfd8e39c34c8e11639", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 8. Common FAQs\n\n**Q: How long does a refund take?**\nA: Refunds are processed within 5\u20137 business days after approval. The time to appear in the customer's account depends on their bank.\n\n**Q: Can I return a product I've used?**\nA: Generally no. Products must be in original, unused condition. Exceptions apply for defective or damaged items.\n\n**Q: Can I get a refund without returning the item?**\nA: Only in cases of damage on arrival or manufacturing defect confirmed by the support team.\n\n**Q: What if I don't have my order number?**\nA: The agent can look up the order using the customer's registered email address.\n\n**Q: Do you offer free returns?**\nA: Yes, for wrong items delivered and damaged/defective items. Standard returns may incur a return shipping fee depending on the reason.\n\n**Q: Can I exchange instead of getting a refund?**\nA: Yes, subject to stock availability. See the Exchange Policy section above.\n\n---", "mimetype": "text/plain", "start_char_idx": 5131, "end_char_idx": 6058, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "ffb13021-2037-4f02-93dc-a6deae7862bf": {"__data__": {"id_": "ffb13021-2037-4f02-93dc-a6deae7862bf", "embedding": null, "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c", "node_type": "4", "metadata": {"source": "knowledge-base.md"}, "hash": "7cb11b28689ffc6deb895f72bcdef66dbf2f4fa202b140117d59fca772b9db86", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "9c810261-d9fa-4796-9415-1cfd47c5ffa3", "node_type": "1", "metadata": {"source": "knowledge-base.md", "header_path": "/Customer Support Knowledge Base/"}, "hash": "9fe7764b965a369a788dc41f75e264f5aca4292c0456b5cc95cb765ce2133bbe", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## 9. Tone & Communication Guidelines\n\n- Always address the customer by their first name.\n- Be empathetic and professional \u2014 never dismissive.\n- If declining a request, always explain the reason clearly and offer an alternative where possible.\n- Avoid jargon. Write in plain, clear language.\n- For escalations, keep the customer informed that their case is being reviewed by a specialist.", "mimetype": "text/plain", "start_char_idx": 6060, "end_char_idx": 6448, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"b0d692ed-bc05-4b0b-94ce-d33bc80accac": {"doc_hash": "448feb5adad017f242a637e5fd62ac7ca2d182688eb57b8b73745b3026c3adc5", "ref_doc_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c"}, "cb98e315-5e64-4ec4-8639-d1f0e54ffc66": {"doc_hash": "5f8c1f5ef6f430f09ec2406818fe0ca58b96cb43e406d675bb7f9a8a40b3cd8d", "ref_doc_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c"}, "f8aa5190-60a7-449c-94e0-9a9505ab7011": {"doc_hash": "5c229fa07d125e5cb8bc005ab407a5f0e4bd88df77e45afef177a8fff7b66a5e", "ref_doc_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c"}, "19dfb992-df43-4990-aa3f-190def7fbd43": {"doc_hash": "cc85c46fd45342e713647c68a011b47bde2c84ed6bee01d177cdf7f2bf6ad566", "ref_doc_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c"}, "1d92ffb0-1bd7-49c5-91d2-34c044052b45": {"doc_hash": "49d2750d5a0b8d310ed561e0f5feae7d85ab97585d9576c4a648e99b1783c662", "ref_doc_id": "c7a9ff2f-fd55-4971-9047-5b15d6693c1c